{
    "name": "tesla-fleet-api",
    "version": "0.4.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/Teslemetry/node-tesla-fleet-api"
    },
    "author": {
        "name": "Teslemetry",
        "email": "hello@teslemetry.com",
        "url": "https://teslemetry.com"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "eslint": "^10.8.0",
        "homey-apps-sdk-v3-types": "0.3.12",
        "publint": "^0.3.23",
        "tsdown": "^0.23.4",
        "tsx": "^4.23.15",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.66.0",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "prepare": "tsdown",
        "watch": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "pack:check": "publint && attw --pack . --profile node16",
        "changeset": "changeset",
        "ci:publish": "changeset publish",
        "build": "tsdown",
        "powerwall:check": "tsx scripts/powerwall-readonly-check.ts",
        "ble:live": "tsx scripts/ble-live/run.ts"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "tesla",
        "tesla fleet api",
        "teslemetry",
        "tessie"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./tariff": {
            "import": {
                "types": "./dist/tariff.d.mts",
                "default": "./dist/tariff.mjs"
            },
            "require": {
                "types": "./dist/tariff.d.cts",
                "default": "./dist/tariff.cjs"
            }
        },
        "./const": {
            "import": {
                "types": "./dist/const.d.mts",
                "default": "./dist/const.mjs"
            },
            "require": {
                "types": "./dist/const.d.cts",
                "default": "./dist/const.cjs"
            }
        },
        "./router": {
            "import": {
                "types": "./dist/router.d.mts",
                "default": "./dist/router.mjs"
            },
            "require": {
                "types": "./dist/router.d.cts",
                "default": "./dist/router.cjs"
            }
        },
        "./types": {
            "import": {
                "types": "./dist/types.d.mts",
                "default": "./dist/types.mjs"
            },
            "require": {
                "types": "./dist/types.d.cts",
                "default": "./dist/types.cjs"
            }
        },
        "./bluetooth": {
            "import": {
                "types": "./dist/bluetooth.d.mts",
                "default": "./dist/bluetooth.mjs"
            },
            "require": {
                "types": "./dist/bluetooth.d.cts",
                "default": "./dist/bluetooth.cjs"
            }
        },
        "./bluetooth/homey": {
            "import": {
                "types": "./dist/bluetooth/homey.d.mts",
                "default": "./dist/bluetooth/homey.mjs"
            },
            "require": {
                "types": "./dist/bluetooth/homey.d.cts",
                "default": "./dist/bluetooth/homey.cjs"
            }
        },
        "./bluetooth/noble": {
            "import": {
                "types": "./dist/bluetooth/noble.d.mts",
                "default": "./dist/bluetooth/noble.mjs"
            },
            "require": {
                "types": "./dist/bluetooth/noble.d.cts",
                "default": "./dist/bluetooth/noble.cjs"
            }
        },
        "./bluetooth/esphome": {
            "import": {
                "types": "./dist/bluetooth/esphome.d.mts",
                "default": "./dist/bluetooth/esphome.mjs"
            },
            "require": {
                "types": "./dist/bluetooth/esphome.d.cts",
                "default": "./dist/bluetooth/esphome.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@teslemetry/tesla-protocol": "~6.1.0"
    },
    "peerDependencies": {
        "@2colors/esphome-native-api": "^1.3.6",
        "@stoprocent/noble": "^2.8.0"
    },
    "peerDependenciesMeta": {
        "@2colors/esphome-native-api": {
            "optional": true
        },
        "@stoprocent/noble": {
            "optional": true
        }
    }
}
